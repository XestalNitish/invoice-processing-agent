# Invoice Agent — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Vision LLM ───────────────────────────────────────────────────────────────
# Choose one provider: anthropic | openai | gemini | local
LLM_PROVIDER=anthropic
VISION_MODEL=claude-claude-sonnet-4-5

ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://invoice_user:invoice_pass@localhost:5432/invoice_db
DB_ENCRYPT_AT_REST=true

# ── PII Masking (set true to mask GSTIN/phone in logs) ───────────────────────
PII_MASKING_ENABLED=false

# ── Storage paths (auto-created on first run) ─────────────────────────────────
# Leave blank to use defaults relative to project root
# STORAGE_DIR=./storage
# RAW_IMAGES_DIR=./storage/raw_images
# PROCESSED_IMAGES_DIR=./storage/processed_images
# EXPORTS_DIR=./exports

# ── Validation thresholds ─────────────────────────────────────────────────────
CONFIDENCE_REVIEW_THRESHOLD=0.85
TAX_ARITHMETIC_TOLERANCE=1.00
LINE_ITEM_SUM_TOLERANCE=1.00

# ── Extraction retries ────────────────────────────────────────────────────────
MAX_EXTRACTION_RETRIES=2
